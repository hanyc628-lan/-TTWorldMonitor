{
  "name": "ttworldmonitor",
  "version": "0.1.0",
  "description": "TTWorldMonitor — Real-time table tennis intelligence dashboard",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "mcp": "tsx server/index.ts",
    "test:ittf": "node scripts/test-ittf.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "start:cloud": "tsx server/index.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hls.js": "^1.7.0",
    "ittf-pingpong": "^2.0.1",
    "jmespath": "^0.16.0",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "react-simple-maps": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/jmespath": "^0.15.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
